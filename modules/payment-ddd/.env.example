# Example environment variables for payment-ddd module

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payment
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Stripe test key (set in your environment or CI secrets)
STRIPE_API_KEY=sk_test_your_test_key_here

# PayPal sandbox config (not stored here in repo)
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
